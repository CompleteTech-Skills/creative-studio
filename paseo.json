{
  "worktree": {
    "setup": [
      "python -m venv .venv",
      ".venv/Scripts/python.exe -m pip install -r requirements-delivery.txt -r requirements-rig-test.txt",
      "npm ci --ignore-scripts --prefix tools/rig"
