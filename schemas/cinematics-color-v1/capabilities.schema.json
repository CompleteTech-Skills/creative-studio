{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cinematics color capabilities v1",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "cinematics-color-capabilities"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "ocio_version": {
      "const": "2.5.2"
    },
    "config": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cinematics-color-config"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "config_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9._/-]+$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 33554432
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 256
        },
        "search_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "declared_roles": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "required": [
            "scene_linear",
            "cie_xyz_d65_interchange"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "file_transforms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9._/-]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9._/-]+$"
              }
            },
            "required": [
              "source",
              "path"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        },
        "closure_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "config_path",
        "config_sha256",
        "files",
        "search_paths",
        "declared_roles",
        "file_transforms",
        "closure_sha256"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "color_spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "is_data": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "required": [
          "name",
          "is_data",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "displays": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "views": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "looks": {
                  "type": "string",
                  "maxLength": 1024
                }
              },
              "required": [
                "name",
                "looks"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 64
          }
        },
        "required": [
          "name",
          "views"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "looks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "kind",
    "schema_version",
    "ocio_version",
    "config",
    "roles",
    "color_spaces",
    "displays",
    "looks"
  ],
  "additionalProperties": false
}
