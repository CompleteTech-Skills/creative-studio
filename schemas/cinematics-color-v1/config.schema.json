{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cinematics color config v1",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "cinematics-color-config"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "config_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 33554432
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "search_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9._/-]+$"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "declared_roles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "required": [
        "scene_linear",
        "cie_xyz_d65_interchange"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "file_transforms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9._/-]+$"
          }
        },
        "required": [
          "source",
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "closure_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "config_path",
    "config_sha256",
    "files",
    "search_paths",
    "declared_roles",
    "file_transforms",
    "closure_sha256"
  ],
  "additionalProperties": false
}
