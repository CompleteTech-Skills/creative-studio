{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creative-studio.invalid/cinematics-exposure-v1/advice.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "source_time",
    "sequence_id",
    "enabled",
    "policy",
    "policy_sha256",
    "authored_stops",
    "desired_correction_stops",
    "correction_stops",
    "total_stops",
    "meter_sha256",
    "previous_state_sha256",
    "pixel_transform_executed",
    "exposure_applications",
    "state_sha256"
  ],
  "properties": {
    "kind": {
      "const": "cinematics-exposure-advice"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "source_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740992
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740992
        }
      }
    },
    "sequence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[ -~]+$"
    },
    "enabled": {
      "type": "boolean"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_gray",
        "minimum_stops",
        "maximum_stops",
        "adaptation_seconds"
      ],
      "properties": {
        "target_gray": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1
        },
        "minimum_stops": {
          "type": "number",
          "minimum": -24,
          "maximum": 0
        },
        "maximum_stops": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "adaptation_seconds": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 3600
        }
      }
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authored_stops": {
      "type": "number",
      "minimum": -24,
      "maximum": 24
    },
    "desired_correction_stops": {
      "type": "number",
      "minimum": -24,
      "maximum": 24
    },
    "correction_stops": {
      "type": "number",
      "minimum": -24,
      "maximum": 24
    },
    "total_stops": {
      "type": "number",
      "minimum": -24,
      "maximum": 24
    },
    "meter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_state_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pixel_transform_executed": {
      "const": false
    },
    "exposure_applications": {
      "const": 0,
      "type": "integer"
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
