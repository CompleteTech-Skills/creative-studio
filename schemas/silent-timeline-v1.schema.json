{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Silent timeline v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "silent-timeline"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "silent-frame-source"
        },
        "origin": {
          "enum": [
            "synthetic",
            "production2d",
            "blender3d",
            "assembled"
          ]
        },
        "format": {
          "const": "png"
        },
        "precision": {
          "const": 8
        },
        "alpha": {
          "const": "opaque"
        },
        "color": {
          "const": "untagged-sdr"
        },
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "fps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240000
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "numerator",
            "denominator"
          ]
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 17999
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "[0-9a-f]{64}"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 67108864
              }
            },
            "required": [
              "index",
              "path",
              "sha256",
              "bytes"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "origin",
        "format",
        "precision",
        "alpha",
        "color",
        "width",
        "height",
        "fps",
        "frames"
      ]
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,127}"
          },
          "context": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "project": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "id",
                      "version"
                    ]
                  },
                  "scene": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "id",
                      "version"
                    ]
                  },
                  "shot": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "id",
                      "version"
                    ]
                  }
                },
                "required": [
                  "project",
                  "scene",
                  "shot"
                ]
              }
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "const": 1
              },
              "kind": {
                "const": "silent-frame-source"
              },
              "origin": {
                "enum": [
                  "synthetic",
                  "production2d",
                  "blender3d",
                  "assembled"
                ]
              },
              "format": {
                "const": "png"
              },
              "precision": {
                "const": 8
              },
              "alpha": {
                "const": "opaque"
              },
              "color": {
                "const": "untagged-sdr"
              },
              "width": {
                "type": "integer",
                "minimum": 2,
                "maximum": 4096
              },
              "height": {
                "type": "integer",
                "minimum": 2,
                "maximum": 4096
              },
              "fps": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "numerator": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 240000
                  },
                  "denominator": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ]
              },
              "frames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 18000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 17999
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "[0-9a-f]{64}"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 67108864
                    }
                  },
                  "required": [
                    "index",
                    "path",
                    "sha256",
                    "bytes"
                  ]
                }
              }
            },
            "required": [
              "schema_version",
              "kind",
              "origin",
              "format",
              "precision",
              "alpha",
              "color",
              "width",
              "height",
              "fps",
              "frames"
            ]
          },
          "source_sha256": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17999
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18000
          },
          "output_start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17999
          },
          "output_end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18000
          }
        },
        "required": [
          "id",
          "context",
          "source",
          "source_sha256",
          "start",
          "end",
          "output_start",
          "output_end"
        ]
      }
    },
    "mapping": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17999
          },
          "shot_id": {
            "type": "string",
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,127}"
          },
          "source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17999
          },
          "source_sha256": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "pts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "numerator": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "denominator": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000000
              }
            },
            "required": [
              "numerator",
              "denominator"
            ]
          }
        },
        "required": [
          "index",
          "shot_id",
          "source_index",
          "source_sha256",
          "pts"
        ]
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "audio_policy": {
      "const": "forbidden"
    },
    "visual_review": {
      "const": "not-performed"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "source",
    "shots",
    "mapping",
    "duration",
    "audio_policy",
    "visual_review"
  ]
}
