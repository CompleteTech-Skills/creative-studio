{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Silent video artifact v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "silent-video-verification"
    },
    "verified": {
      "const": true
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "artifact_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483648
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "video_stream_count": {
      "const": 1
    },
    "audio_stream_count": {
      "const": 0
    },
    "other_stream_count": {
      "const": 0
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18000
    },
    "fps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "timebase_tolerance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "profile": {
      "enum": [
        "h264-mp4",
        "vp9-webm"
      ]
    },
    "source_pixel_comparison": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17999
          },
          "rgb_psnr_db": {
            "type": "number",
            "minimum": 18,
            "maximum": 100
          },
          "minimum_psnr_db": {
            "const": 18.0
          }
        },
        "required": [
          "index",
          "rgb_psnr_db",
          "minimum_psnr_db"
        ]
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "exit_status": {
          "const": 0
        },
        "stdout": {
          "type": "string",
          "maxLength": 67108864
        },
        "stderr": {
          "type": "string",
          "maxLength": 67108864
        }
      },
      "required": [
        "command",
        "exit_status",
        "stdout",
        "stderr"
      ]
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "exit_status": {
          "const": 0
        },
        "stdout": {
          "type": "string",
          "maxLength": 67108864
        },
        "stderr": {
          "type": "string",
          "maxLength": 67108864
        }
      },
      "required": [
        "command",
        "exit_status",
        "stdout",
        "stderr"
      ]
    },
    "decode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "exit_status": {
          "const": 0
        },
        "stdout": {
          "type": "string",
          "maxLength": 67108864
        },
        "stderr": {
          "type": "string",
          "maxLength": 67108864
        }
      },
      "required": [
        "command",
        "exit_status",
        "stdout",
        "stderr"
      ]
    },
    "visual_review": {
      "const": "not-performed"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "verified",
    "artifact_sha256",
    "artifact_bytes",
    "source_manifest_sha256",
    "request_sha256",
    "video_stream_count",
    "audio_stream_count",
    "other_stream_count",
    "frame_count",
    "fps",
    "duration",
    "timebase_tolerance",
    "profile",
    "source_pixel_comparison",
    "probe",
    "timeline",
    "decode",
    "visual_review"
  ]
}
