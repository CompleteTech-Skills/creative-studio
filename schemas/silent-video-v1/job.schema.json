{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Silent video job v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "silent-video-job"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "verifying",
        "complete",
        "failed",
        "cancelled"
      ]
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "(?:[0-9a-f]{64})?"
    },
    "error": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request_sha256",
    "source_manifest_sha256",
    "status",
    "artifact_sha256",
    "error"
  ]
}
