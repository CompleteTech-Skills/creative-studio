{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Silent video source v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "silent-frame-source"
    },
    "origin": {
      "enum": [
        "synthetic",
        "production2d",
        "blender3d",
        "assembled",
        "transformed"
      ]
    },
    "format": {
      "const": "png"
    },
    "precision": {
      "const": 8
    },
    "alpha": {
      "const": "opaque"
    },
    "color": {
      "const": "untagged-sdr"
    },
    "width": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4096
    },
    "fps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17999
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          }
        },
        "required": [
          "index",
          "path",
          "sha256",
          "bytes"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "origin",
    "format",
    "precision",
    "alpha",
    "color",
    "width",
    "height",
    "fps",
    "frames"
  ]
}
