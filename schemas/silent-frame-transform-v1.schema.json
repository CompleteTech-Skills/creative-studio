    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "pillow-lanczos-center"
        },
        "pillow_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "code_sha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        }
      },
      "required": [
        "id",
        "pillow_version",
        "code_sha256"
      ]
    },
    "visual_review": {
      "const": "not-performed"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "input_source",
    "input_source_sha256",
    "profile",
    "profile_sha256",
    "source",
    "mapping",
    "input_duration",
    "output_duration",
    "duration_delta",
    "implementation",
    "visual_review"
  ]
}
