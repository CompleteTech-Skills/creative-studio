{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "silent-frame-transform"
    },
    "input_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "silent-frame-source"
        },
        "origin": {
          "enum": [
            "synthetic",
            "production2d",
            "blender3d",
            "assembled",
            "transformed"
          ]
        },
        "format": {
          "const": "png"
        },
        "precision": {
          "const": 8
        },
        "alpha": {
          "const": "opaque"
        },
        "color": {
          "const": "untagged-sdr"
        },
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "fps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240000
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "numerator",
            "denominator"
          ]
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 17999
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "[0-9a-f]{64}"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 67108864
              }
            },
            "required": [
              "index",
              "path",
              "sha256",
              "bytes"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "origin",
        "format",
        "precision",
        "alpha",
        "color",
        "width",
        "height",
        "fps",
        "frames"
      ]
    },
    "input_source_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "silent-frame-profile"
        },
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "fps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240000
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "numerator",
            "denominator"
          ]
        },
        "fit": {
          "enum": [
            "preserve",
            "letterbox",
            "fill",
            "stretch"
          ]
        },
        "fps_policy": {
          "enum": [
            "preserve",
            "nearest"
          ]
        },
        "background": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "width",
        "height",
        "fps",
        "fit",
        "fps_policy",
        "background"
      ]
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "silent-frame-source"
        },
        "origin": {
          "enum": [
            "synthetic",
            "production2d",
            "blender3d",
            "assembled",
            "transformed"
          ]
        },
        "format": {
          "const": "png"
        },
        "precision": {
          "const": 8
        },
        "alpha": {
          "const": "opaque"
        },
        "color": {
          "const": "untagged-sdr"
        },
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "fps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240000
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "numerator",
            "denominator"
          ]
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 17999
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "[0-9a-f]{64}"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 67108864
              }
            },
            "required": [
              "index",
              "path",
              "sha256",
              "bytes"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "origin",
        "format",
        "precision",
        "alpha",
        "color",
        "width",
        "height",
        "fps",
        "frames"
      ]
    },
    "mapping": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17999
          },
          "source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17999
          },
          "pts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "numerator": {
                "type": "integer",
                "minimum": -1000000000000,
                "maximum": 1000000000000
              },
              "denominator": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000000
              }
            },
            "required": [
              "numerator",
              "denominator"
            ]
          }
        },
        "required": [
          "index",
          "source_index",
          "pts"
        ]
      }
    },
    "input_duration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": -1000000000000,
          "maximum": 1000000000000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "output_duration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": -1000000000000,
          "maximum": 1000000000000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "duration_delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": -1000000000000,
