{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animation3D retarget v1",
  "$ref": "#/$defs/retarget",
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "kind"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "generated",
            "imported",
            "authored",
            "derived",
            "fixture"
          ]
        },
        "fixture": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "permissions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxProperties": 128
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 4096
          },
          "maxProperties": 128
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "parent_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        }
      },
      "required": [
        "origin",
        "kind",
        "fixture",
        "sources"
      ]
    },
    "retarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "animation_retarget_3d"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "source_rig": {
          "$ref": "#/$defs/asset"
        },
        "target_rig": {
          "$ref": "#/$defs/asset"
        },
        "source_skeleton_signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "target_skeleton_signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "source_rest_pose": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "target_rest_pose": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_bone": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "target_bone": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "rotation_offset": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                "minItems": 4,
                "maxItems": 4
              },
              "translation_scale": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "mode": {
                "enum": [
                  "rotation",
                  "translation",
                  "full_transform"
                ]
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "source_bone",
              "target_bone",
              "rotation_offset",
              "mode"
            ]
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "root_policy": {
          "enum": [
            "preserve_world",
            "scale_to_target",
            "in_place"
          ]
        },
        "scale_policy": {
          "enum": [
            "height_ratio",
            "leg_length_ratio",
            "explicit"
          ]
        },
        "explicit_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0
        },
        "preserve_end_effectors": {
          "type": "boolean"
        },
        "preserve_contacts": {
          "type": "boolean"
        },
        "missing_bone_policy": {
          "enum": [
            "error",
            "warn",
            "ignore"
          ]
        },
        "validation_thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maximum_joint_error_rad": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000.0
            },
            "maximum_contact_error_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000.0
            },
            "maximum_root_drift_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000.0
            }
          },
          "required": [
            "maximum_joint_error_rad",
            "maximum_contact_error_m",
            "maximum_root_drift_m"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "source_rig",
        "target_rig",
        "source_skeleton_signature",
        "target_skeleton_signature",
        "source_rest_pose",
        "target_rest_pose",
        "mappings",
        "root_policy",
        "scale_policy",
        "preserve_end_effectors",
        "preserve_contacts",
        "missing_bone_policy",
        "validation_thresholds",
        "provenance"
      ]
    }
  }
}
