{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Particle settings bound to exact PhysicsWorld v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "world_sha256",
    "emitters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "hatch-physics-particle-settings"
    },
    "world_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "emitters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "shape",
          "rate",
          "burst",
          "start",
          "end",
          "spread",
          "drag",
          "restitution",
          "collision"
        ],
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "shape": {
            "enum": [
              "point",
              "box",
              "sphere",
              "mesh-surface"
            ]
          },
          "rate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "denominator": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            }
          },
          "start": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "denominator": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            }
          },
          "end": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "denominator": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            }
          },
          "burst": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024
          },
          "spread": {
            "type": "number",
            "minimum": 0,
            "maximum": 3.141592653589793
          },
          "drag": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "restitution": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "collision": {
            "enum": [
              "none",
              "bounce",
              "remove"
            ]
          }
        }
      }
    }
  }
}
