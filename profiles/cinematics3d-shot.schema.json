{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gethatch.pet/schemas/cinematics3d-shot-v1",
  "$defs": {
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "const": "cinematics3d-shot"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "registry_version": {
          "const": "1.0.0"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fixture": {
              "type": "boolean"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "fixture",
            "description"
          ]
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "scene3d-shot",
                    "camera3d-shot"
                  ]
                }
              }
            }
          ]
        },
        "stack": {
          "allOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "cinematics3d-stack"
                  ]
                }
              }
            }
          ]
        },
        "fps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "numerator",
            "denominator"
          ]
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999
            },
            "ticks_per_frame": {
              "const": 1000000
            }
          },
          "required": [
            "frame",
            "ticks",
            "ticks_per_frame"
          ]
        },
        "end": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999
            },
            "ticks_per_frame": {
              "const": 1000000
            }
          },
          "required": [
            "frame",
            "ticks",
            "ticks_per_frame"
          ]
        },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "working_space": {
              "const": "scene-linear-srgb"
            },
            "alpha": {
              "enum": [
                "straight",
                "premultiplied"
              ]
            },
            "display_space": {
              "enum": [
                "srgb",
                "rec709",
                "rec2020-pq"
              ]
            }
          },
          "required": [
            "working_space",
            "alpha",
            "display_space"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "registry_version",
        "metadata",
        "source",
        "stack",
        "fps",
        "start",
        "end",
        "color"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/) )(?!.*[\\\\:\\x00-\\x1f*?\"<>|])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?!.*[. ](?:/|(?![\\s\\S])))(?!(?:[^/]+/)*(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][nN][iI][nN]\\$|[cC][oO][nN][oO][uU][tT]\\$|[cC][oO][mM][1-9\u00b9\u00b2\u00b3]|[lL][pP][tT][1-9\u00b9\u00b2\u00b3])(?:[.]|/|(?![\\s\\S])))[^/]+(?:/[^/]+)*(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "kind"
      ]
    }
  },
  "$ref": "#/$defs/shot",
  "title": "Cinematic shot authoring contract v1",
  "description": "Structural contract only. Runtime verifies references, cycles, units and policies; no effect execution is claimed."
}
