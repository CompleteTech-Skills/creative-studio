{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gethatch.pet/schemas/cinematics3d-scene-v1",
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "const": "cinematics3d-scene"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "registry_version": {
          "const": "1.0.0"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fixture": {
              "type": "boolean"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "fixture",
            "description"
          ]
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "scene3d-scene"
                  ]
                }
              }
            }
          ]
        },
        "stack": {
          "allOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "cinematics3d-stack"
                  ]
                }
              }
            }
          ]
        },
        "shots": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/reference"
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "cinematics3d-shot"
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^(?!/)(?!.*(?:^|/) )(?!.*[\\\\:\\x00-\\x1f*?\"<>|])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?!.*[. ](?:/|(?![\\s\\S])))(?!(?:[^/]+/)*(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][nN][iI][nN]\\$|[cC][oO][nN][oO][uU][tT]\\$|[cC][oO][mM][1-9\u00b9\u00b2\u00b3]|[lL][pP][tT][1-9\u00b9\u00b2\u00b3])(?:[.]|/|(?![\\s\\S])))[^/]+(?:/[^/]+)*(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  "kind": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}(?![\\s\\S])"
                  }
                },
                "required": [
                  "id",
                  "version",
                  "path",
                  "sha256",
                  "kind"
                ]
              },
              "stack": {
                "allOf": [
                  {
                    "$ref": "#/$defs/reference"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "cinematics3d-stack"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "source",
              "stack"
            ]
          },
          "minItems": 0,
          "maxItems": 4096
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "registry_version",
        "metadata",
        "source",
        "stack",
        "shots",
        "objects"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/) )(?!.*[\\\\:\\x00-\\x1f*?\"<>|])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?!.*[. ](?:/|(?![\\s\\S])))(?!(?:[^/]+/)*(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][nN][iI][nN]\\$|[cC][oO][nN][oO][uU][tT]\\$|[cC][oO][mM][1-9\u00b9\u00b2\u00b3]|[lL][pP][tT][1-9\u00b9\u00b2\u00b3])(?:[.]|/|(?![\\s\\S])))[^/]+(?:/[^/]+)*(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "kind"
      ]
    }
  },
  "$ref": "#/$defs/scene",
  "title": "Cinematic scene authoring contract v1",
  "description": "Structural contract only. Runtime verifies references, cycles, units and policies; no effect execution is claimed."
}
