{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animation3D track v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "animation_track_3d"
    },
    "value": {
      "$ref": "#/$defs/track"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "value"
  ],
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": {
          "$ref": "#/$defs/time"
        },
        "value": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "interpolation": {
          "enum": [
            "step",
            "linear",
            "ease",
            "bezier",
            "hermite",
            "catmull-rom",
            "tcb",
            "quaternion-slerp",
            "quaternion-squad"
          ]
        },
        "ease_in": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ease_out": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "in_tangent": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "out_tangent": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "in_handle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time_delta_frames": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "value_delta": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              ]
            },
            "weighted": {
              "type": "boolean"
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000.0
            }
          },
          "required": [
            "time_delta_frames",
            "value_delta"
          ]
        },
        "out_handle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time_delta_frames": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "value_delta": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              ]
            },
            "weighted": {
              "type": "boolean"
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000.0
            }
          },
          "required": [
            "time_delta_frames",
            "value_delta"
          ]
        },
        "tension": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        },
        "continuity": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        },
        "bias": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 4096
          },
          "maxProperties": 128
        }
      },
      "required": [
        "time",
        "value"
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "node"
            },
            "property": {
              "enum": [
                "translation",
                "rotation",
                "scale",
                "visibility"
              ]
            },
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "node_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bone"
            },
            "property": {
              "enum": [
                "translation",
                "rotation",
                "scale"
              ]
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "bone_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "actor_id",
            "bone_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "morph"
            },
            "property": {
              "enum": [
                "weight"
              ]
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "mesh_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "morph_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "actor_id",
            "mesh_id",
            "morph_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "camera"
            },
            "property": {
              "enum": [
                "translation",
                "rotation",
                "focal_length",
                "field_of_view",
                "orthographic_size",
                "focus_distance",
                "aperture",
                "exposure"
              ]
            },
            "camera_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "camera_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "light"
            },
            "property": {
              "enum": [
                "translation",
                "rotation",
                "color",
                "intensity",
                "range",
                "cone_angle"
              ]
            },
            "light_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "light_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "material"
            },
            "property": {
              "enum": [
                "base_color",
                "emissive_color",
                "opacity",
                "emissive_intensity",
                "roughness",
                "metallic"
              ]
            },
            "material_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "material_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "environment"
            },
            "property": {
              "enum": [
                "sky_rotation",
                "ambient_intensity",
                "fog_density",
                "wind_strength",
                "sun_elevation",
                "time_of_day"
              ]
            }
          },
          "required": [
            "kind",
            "property"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "constraint"
            },
            "property": {
              "enum": [
                "weight",
                "enabled",
                "target_position"
              ]
            },
            "constraint_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "constraint_id"
          ]
        }
      ]
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "subframe_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        }
      },
      "required": [
        "frame"
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "value_type": {
          "enum": [
            "float",
            "boolean",
            "vec3",
            "vec4",
            "quaternion"
          ]
        },
        "coordinate_space": {
          "enum": [
            "local",
            "world",
            "parent"
          ]
        },
        "default_value": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 0,
          "maxItems": 250000
        },
        "extrapolation_before": {
          "enum": [
            "hold",
            "linear",
            "cycle"
          ]
        },
        "extrapolation_after": {
          "enum": [
            "hold",
            "linear",
            "cycle"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "target",
        "value_type",
        "default_value",
        "keys",
        "extrapolation_before",
        "extrapolation_after",
        "enabled"
      ]
    }
  }
}
