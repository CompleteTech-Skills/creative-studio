{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "silent-video-job-plan"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "silent-video-request"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "kind": {
              "const": "silent-frame-source"
            },
            "origin": {
              "enum": [
                "synthetic",
                "production2d",
                "blender3d",
                "assembled",
                "transformed"
              ]
            },
            "format": {
              "const": "png"
            },
            "precision": {
              "const": 8
            },
            "alpha": {
              "const": "opaque"
            },
            "color": {
              "const": "untagged-sdr"
            },
            "width": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4096
            },
            "fps": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 240000
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "required": [
                "numerator",
                "denominator"
              ]
            },
            "frames": {
              "type": "array",
              "minItems": 1,
              "maxItems": 18000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 17999
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "[0-9a-f]{64}"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 67108864
                  }
                },
                "required": [
                  "index",
                  "path",
                  "sha256",
                  "bytes"
                ]
              }
            }
          },
          "required": [
            "schema_version",
            "kind",
            "origin",
            "format",
            "precision",
            "alpha",
            "color",
            "width",
            "height",
            "fps",
            "frames"
          ]
        },
        "profile": {
          "enum": [
            "h264-mp4",
            "vp9-webm",
            "av1-webm"
          ]
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "const": "forbidden"
            }
          },
          "required": [
            "policy"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 2147483648
            },
            "max_log_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 67108864
            }
          },
          "required": [
            "timeout_seconds",
            "max_output_bytes",
            "max_log_bytes"
          ]
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speed": {
              "anyOf": [
                {
                  "enum": [
                    "ultrafast",
                    "superfast",
                    "veryfast",
                    "faster",
                    "fast",
                    "medium",
                    "slow",
                    "slower",
                    "veryslow"
                  ]
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                }
              ]
            },
            "threads": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "gop": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "rate_control": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "const": "quality"
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 63
                    }
                  },
                  "required": [
                    "mode",
                    "value"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "const": "bitrate"
                    },
                    "bitrate": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 1000000000
                    }
                  },
                  "required": [
                    "mode",
                    "bitrate"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "const": "constrained"
                    },
                    "bitrate": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 1000000000
                    },
                    "maxrate": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 1000000000
                    },
                    "bufsize": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 2000000000
                    }
                  },
                  "required": [
                    "mode",
                    "bitrate",
                    "maxrate",
                    "bufsize"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "const": "two-pass"
                    },
                    "bitrate": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 1000000000
                    }
                  },
                  "required": [
                    "mode",
                    "bitrate"
                  ]
                }
              ]
            }
          },
          "required": [
            "speed",
            "threads",
            "gop",
            "rate_control"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "source",
        "profile",
        "audio",
        "limits"
      ]
    },
    "source_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "context": {
      "type": "object"
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ffmpeg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            },
            "version_stdout": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes",
            "version_stdout"
          ]
        },
        "ffprobe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            },
            "version_stdout": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes",
            "version_stdout"
          ]
        }
      },
      "required": [
        "ffmpeg",
        "ffprobe"
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controller": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "encoder": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profiles": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path_boundary": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "controller",
        "encoder",
        "publication",
        "profiles",
        "path_boundary"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_work_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 34359738368
        },
        "max_memory_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 2147483648
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "wall_seconds",
        "max_work_bytes",
        "max_memory_bytes",
        "max_attempts",
        "max_runs"
      ]
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483648
        },
        "peak_work_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 34359738368
        },
        "decoded_memory_estimate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "gpu_bytes": {
          "const": 0
        }
      },
      "required": [
        "source_bytes",
        "peak_work_bytes",
        "decoded_memory_estimate",
        "threads",
        "gpu_bytes"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "request",
    "source_root",
    "destination",
    "context",
    "tools",
    "implementation",
    "budget",
    "estimate"
  ]
}
