{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "ready",
        "awaiting-external",
        "running",
        "interrupted",
        "failed",
        "cancelled",
        "proposed",
        "unsupported",
        "applied"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "applied_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "response_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "status",
    "attempts",
    "request_sha256",
    "applied_revision",
    "error"
  ]
}
