{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RenderSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "render3d-snapshot"
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "required": [
            "id",
            "version"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "required": [
            "id",
            "version"
          ]
        },
        "coordinate_system": {
          "const": {
            "handedness": "right",
            "right": "+X",
            "up": "+Y",
            "forward": "+Z",
            "unit": "meter",
            "angles": "radian",
            "quaternion": "XYZW",
            "matrices": "column-vectors",
            "time": "second"
          }
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 268435456
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ]
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "fixture": {
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "native-rig-preview",
            "scene3d"
          ]
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "adapter",
        "source",
        "coordinate_system",
        "entrypoint",
        "files",
        "total_bytes",
        "fixture",
        "scope",
        "snapshot_sha256"
      ]
    }
  },
  "$ref": "#/$defs/RenderSnapshot",
  "title": "Render3D RenderSnapshot v1"
}
