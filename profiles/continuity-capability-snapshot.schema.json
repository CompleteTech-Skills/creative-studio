{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!.*[\\\\:<>\\\"|?*\\x00-\\x1f])(?:(?! )(?![.]{1,2}(?:/|(?![\\s\\S])))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9\u00b9\u00b2\u00b3]|[Ll][Pp][Tt][1-9\u00b9\u00b2\u00b3]|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$)(?:[.]|/|(?![\\s\\S])))(?![^/]*[. ](?:/|(?![\\s\\S])))[^/]+/)*(?! )(?![.]{1,2}(?:/|(?![\\s\\S])))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9\u00b9\u00b2\u00b3]|[Ll][Pp][Tt][1-9\u00b9\u00b2\u00b3]|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$)(?:[.]|/|(?![\\s\\S])))(?![^/]*[. ](?:/|(?![\\s\\S])))[^/]+(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "kind"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disk_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cpu_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gpu_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "memory_bytes",
        "disk_bytes",
        "cpu_seconds",
        "gpu_bytes",
        "concurrency"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "capability": {
          "enum": [
            "geometry-inspection",
            "blender-native-inspection",
            "scene-animation-evaluation",
            "rig-compatibility",
            "physics-continuation",
            "spatial-screen-checks",
            "visual-reference",
            "visual-comparison",
            "gpu-rendering",
            "video-encoding",
            "graphical-editor",
            "ai-interpretation",
            "historical-media"
          ]
        },
        "schema_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointer"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "input_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "output_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "resources": {
          "$ref": "#/$defs/limits"
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "allow_fallback": {
          "type": "boolean"
        },
        "gpu_required": {
          "type": "boolean"
        },
        "needs_visual_approval": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "capability",
        "schema_version",
        "inputs",
        "input_types",
        "output_types",
        "resources",
        "required_fields",
        "allow_fallback",
        "gpu_required",
        "needs_visual_approval"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "continuity-capability-request"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "project_revision": {
          "$ref": "#/$defs/pointer"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "required": [
        "schema_version",
        "kind",
        "request_id",
        "project_revision",
        "checks"
      ]
    },
    "host-policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offline": {
          "type": "boolean"
        },
        "asset_rights": {
          "type": "boolean"
        },
        "allowed_owners": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "required": [
        "offline",
        "asset_rights",
        "allowed_owners",
        "limits"
      ]
    },
    "execution-result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointer"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "measurements": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 128
        },
        "outcome": {
          "enum": [
            "executed",
            "partial",
            "needs_visual_review",
            "failed",
            "canceled"
          ]
        }
      },
      "required": [
        "evidence",
        "measurements",
        "verified_fields",
        "limitations",
        "outcome"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "continuity-capability-snapshot"
        },
        "capability_id": {
          "enum": [
            "geometry-inspection",
            "blender-native-inspection",
            "scene-animation-evaluation",
            "rig-compatibility",
            "physics-continuation",
            "spatial-screen-checks",
            "visual-reference",
            "visual-comparison",
            "gpu-rendering",
            "video-encoding",
            "graphical-editor",
            "ai-interpretation",
            "historical-media"
          ]
        },
        "implementation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "backend": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "backend_version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "input_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "output_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "untested"
          ]
        },
        "discovered": {
          "type": "boolean"
        },
        "tested_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointer"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "offline": {
          "type": "boolean"
        },
        "asset_rights_required": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "schema_version",
        "kind",
        "capability_id",
        "implementation_id",
        "owner",
        "backend",
        "backend_version",
        "contract_version",
        "input_types",
        "output_types",
        "operations",
        "status",
        "discovered",
        "tested_operations",
        "evidence",
        "limits",
        "offline",
        "asset_rights_required",
        "expires_at",
        "limitations"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "continuity-capability-result"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "outcome": {
          "enum": [
            "executed",
            "supported_fallback",
            "partial",
            "blocked_missing_capability",
            "needs_visual_review",
            "failed",
            "canceled"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check-result"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "integrity": {
          "enum": [
            "verified",
            "failed"
          ]
        },
        "visual_approval": {
          "const": false
        },
        "host_policy": {
          "$ref": "#/$defs/host-policy"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "request_sha256",
        "request_id",
        "outcome",
        "checks",
        "integrity",
        "visual_approval",
        "host_policy",
        "report_sha256"
      ]
    },
    "check-result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "capability": {
          "enum": [
            "geometry-inspection",
            "blender-native-inspection",
            "scene-animation-evaluation",
            "rig-compatibility",
            "physics-continuation",
            "spatial-screen-checks",
            "visual-reference",
            "visual-comparison",
            "gpu-rendering",
            "video-encoding",
            "graphical-editor",
            "ai-interpretation",
            "historical-media"
          ]
        },
        "outcome": {
          "enum": [
            "executed",
            "supported_fallback",
            "partial",
            "blocked_missing_capability",
            "needs_visual_review",
            "failed",
            "canceled"
          ]
        },
        "implementation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "backend": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "backend_version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "unsatisfied_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointer"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "measurements": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 128
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "capability",
        "outcome",
        "implementation_id",
        "owner",
        "backend",
        "backend_version",
        "snapshot_sha256",
        "snapshot",
        "missing_fields",
        "unsatisfied_gates",
        "evidence",
        "measurements",
        "limitations",
        "elapsed_seconds",
        "error"
      ]
    }
  },
  "$ref": "#/$defs/snapshot"
}
