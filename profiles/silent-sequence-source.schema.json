{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "silent-sequence-source"
    },
    "origin": {
      "enum": [
        "imported",
        "blender3d"
      ]
    },
    "identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      }
    },
    "fps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "png",
            "exr"
          ]
        },
        "bit_depth": {
          "enum": [
            8,
            16,
            32
          ]
        },
        "passes": {
          "const": [
            "combined"
          ]
        },
        "alpha": {
          "enum": [
            "straight",
            "opaque"
          ]
        },
        "color_space": {
          "enum": [
            "srgb",
            "linear"
          ]
        }
      },
      "required": [
        "format",
        "bit_depth",
        "passes",
        "alpha",
        "color_space"
      ]
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17999
          },
          "source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          }
        },
        "required": [
          "index",
          "source_index",
          "source_path",
          "path",
          "sha256",
          "bytes"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "origin",
    "identity_sha256",
    "resolution",
    "fps",
    "output",
    "frames"
  ]
}
