{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animation3D interaction v1",
  "$ref": "#/$defs/interaction",
  "$defs": {
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "animation_interaction_3d"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "actor_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "role": {
                "enum": [
                  "giver",
                  "receiver",
                  "support",
                  "participant"
                ]
              },
              "hand_bone": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "grip_anchor": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "interaction_marker": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              }
            },
            "required": [
              "actor_id",
              "role"
            ]
          },
          "minItems": 1,
          "maxItems": 128
        },
        "prop_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "synchronization_markers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "ownership_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "previous_owner": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "next_owner": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "previous_anchor": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "next_anchor": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "world_pose_policy": {
                "enum": [
                  "preserve",
                  "blend_to_receiver",
                  "explicit"
                ]
              },
              "transfer_duration_frames": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              }
            },
            "required": [
              "frame",
              "world_pose_policy"
            ]
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "position_tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0
        },
        "orientation_tolerance_rad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0
        },
        "failure_policy": {
          "enum": [
            "error",
            "flag_for_review"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "participants",
        "start_frame",
        "end_frame",
        "synchronization_markers",
        "constraints",
        "position_tolerance_m",
        "orientation_tolerance_rad",
        "failure_policy"
      ]
    }
  }
}
