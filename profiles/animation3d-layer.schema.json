          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "clip",
        "start_frame",
        "duration_frames",
        "source_in_frame",
        "playback_rate",
        "blend_in_frames",
        "blend_out_frames",
        "weight",
        "layer_id",
        "enabled"
      ]
