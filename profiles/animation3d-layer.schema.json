        "out_handle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time_delta_frames": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "value_delta": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              ]
            },
            "weighted": {
              "type": "boolean"
