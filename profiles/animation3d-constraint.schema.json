{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animation3D constraint v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "animation_constraint_3d"
    },
    "value": {
      "$ref": "#/$defs/constraint"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "value"
  ],
  "$defs": {
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "enum": [
            "look_at",
            "aim",
            "parent",
            "position",
            "rotation",
            "scale",
            "distance",
            "limit",
            "two_bone_ik",
            "multi_bone_ik",
            "foot_plant",
            "grasp",
            "path_follow"
          ]
        },
        "source": {
          "$ref": "#/$defs/target"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "target_object_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "target_position": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000000.0,
            "maximum": 1000000000.0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "pole_target": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000000.0,
            "maximum": 1000000000.0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "chain_bones": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "position_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "maximum": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "minimum",
            "maximum"
          ]
        },
        "rotation_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum_rad": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "maximum_rad": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "minimum_rad",
            "maximum_rad"
          ]
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "weight",
        "enabled"
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "node"
            },
            "property": {
              "enum": [
                "translation",
                "rotation",
                "scale",
                "visibility"
              ]
            },
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "node_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bone"
            },
            "property": {
              "enum": [
                "translation",
                "rotation",
                "scale"
              ]
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "bone_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "actor_id",
            "bone_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "morph"
            },
            "property": {
              "enum": [
                "weight"
              ]
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "mesh_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "morph_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "actor_id",
            "mesh_id",
            "morph_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "camera"
            },
            "property": {
              "enum": [
                "translation",
                "rotation",
                "focal_length",
                "field_of_view",
                "orthographic_size",
                "focus_distance",
                "aperture",
                "exposure"
              ]
            },
            "camera_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "camera_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "light"
            },
            "property": {
              "enum": [
                "translation",
                "rotation",
                "color",
                "intensity",
                "range",
                "cone_angle"
              ]
            },
            "light_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "light_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "material"
            },
            "property": {
              "enum": [
                "base_color",
                "emissive_color",
                "opacity",
                "emissive_intensity",
                "roughness",
                "metallic"
              ]
            },
            "material_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "material_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "environment"
            },
            "property": {
              "enum": [
                "sky_rotation",
                "ambient_intensity",
                "fog_density",
                "wind_strength",
                "sun_elevation",
                "time_of_day"
              ]
            }
          },
          "required": [
            "kind",
            "property"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "constraint"
            },
            "property": {
              "enum": [
                "weight",
                "enabled",
                "target_position"
              ]
            },
            "constraint_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "property",
            "constraint_id"
          ]
        }
      ]
    }
  }
}
