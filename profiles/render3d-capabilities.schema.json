{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BackendCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "render3d-capabilities"
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "required": [
            "id",
            "version"
          ]
        },
        "backend": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
                },
                "adapter_version": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
                },
                "application_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "executable_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                },
                "worker_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                },
                "platform": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "engine": {
                  "enum": [
                    "cycles",
                    "eevee"
                  ]
                },
                "device": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
                }
              },
              "required": [
                "id",
                "adapter_version",
                "application_version",
                "executable_sha256",
                "worker_sha256",
                "platform",
                "engine",
                "device"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "discovery": {
          "enum": [
            "available",
            "unavailable",
            "untested"
          ]
        },
        "initialization": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "execution": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 268435456
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ]
          },
          "minItems": 0,
          "maxItems": 128
        },
        "engines": {
          "type": "array",
          "items": {
            "enum": [
              "cycles",
              "eevee"
            ]
          },
          "minItems": 0,
          "maxItems": 2
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "category": {
                "enum": [
                  "invalid-input",
                  "missing-asset",
                  "stale-asset",
                  "unsupported-feature",
                  "unsupported-backend",
                  "unsupported-device",
                  "device-initialization",
                  "gpu-out-of-memory",
                  "system-memory",
                  "storage-exhaustion",
                  "timeout",
                  "worker-crash",
                  "cancelled",
                  "corrupt-output",
                  "incomplete-output",
                  "stale-cache",
                  "verification-failed",
                  "external-tool",
                  "ownership"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "path": {
                "type": "string",
                "maxLength": 1024
              },
              "remediation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "code",
              "category",
              "message",
              "path",
              "remediation"
            ]
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "schema_version",
        "kind",
        "adapter",
        "backend",
        "discovery",
        "initialization",
        "execution",
        "evidence",
        "engines",
        "features",
        "diagnostics"
      ]
    }
  },
  "$ref": "#/$defs/BackendCapabilities",
  "title": "Render3D BackendCapabilities v1"
}
