  "required": [
    "schema_version",
    "kind",
    "format",
    "vertices",
    "triangles",
    "files",
    "mesh_identity",
    "material_names",
    "exported_material_slots",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hatch Model3D model3d-mesh-export v1",
  "description": "Structural validation only; runtime checks references and counts. No filesystem integrity or approval claim."
}
