{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "base_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "decomposition-analysis-request"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "width",
        "height"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "foreground",
              "reference"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "role",
          "path",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 16
    },
    "taxonomy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "minItems": 1,
      "maxItems": 128
    },
    "backend": {
      "enum": [
        "opencv-haar",
        "external"
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "name",
                  "sha256"
                ]
              },
              "minItems": 0,
              "maxItems": 32
            },
            "identity_evidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "required": [
            "provider",
            "name",
            "version",
            "files",
            "identity_evidence"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt": {
      "type": "string",
      "maxLength": 16384
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale_factor": {
          "type": "number",
          "minimum": 1.01,
          "maximum": 2
        },
        "min_neighbors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "scale_factor",
        "min_neighbors"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "const": true
        },
        "network_allowed": {
          "const": false
        },
        "max_cost": {
          "const": 0
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "max_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000000
        }
      },
      "required": [
        "enabled",
        "network_allowed",
        "max_cost",
        "max_seconds",
        "max_pixels"
      ]
    }
  },
  "required": [
    "base_manifest_sha256",
    "schema_version",
    "kind",
    "source",
    "references",
    "taxonomy",
    "backend",
    "model",
    "prompt",
    "parameters",
    "policy"
  ]
}
