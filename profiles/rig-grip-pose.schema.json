{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gethatch.pet/schemas/rig-grip-pose-v1",
  "title": "GripPose v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "hatch-3d-grip-pose"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "rig_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "rig_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "rig_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "expected_owner": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "translation": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "rotation": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 4,
              "maxItems": 4
            },
            "scale": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "translation",
            "rotation",
            "scale"
          ]
        }
      },
      "required": [
        "id",
        "expected_owner",
        "transform"
      ]
    },
    "grips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "chain": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "socket": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "transform": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "translation": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                "minItems": 4,
                "maxItems": 4
              },
              "scale": {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000000.0
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "translation",
              "rotation",
              "scale"
            ]
          }
        },
        "required": [
          "id",
          "chain",
          "socket",
          "transform"
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "position_tolerance_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.1
    },
    "orientation_tolerance_rad": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "rig_id",
    "rig_version",
    "rig_sha256",
    "object",
    "grips",
    "position_tolerance_m",
    "orientation_tolerance_rad"
  ]
}
