{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "foreground-proposals"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "fixture": {
          "type": "boolean"
        }
      },
      "required": [
        "asset",
        "width",
        "height",
        "origin",
        "fixture"
      ]
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "torchvision-maskrcnn-coco-v1"
        },
        "weights_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "torch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "torchvision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "execution": {
          "const": "local"
        }
      },
      "required": [
        "name",
        "weights_sha256",
        "torch",
        "torchvision",
        "execution"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mask_threshold": {
          "const": 0.5
        },
        "threads": {
          "const": 2
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_pixels": {
          "const": 1500000
        }
      },
      "required": [
        "score_threshold",
        "mask_threshold",
        "threads",
        "max_seconds",
        "max_pixels"
      ]
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mask": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "pixels": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "category",
          "confidence",
          "mask",
          "bbox",
          "pixels"
        ]
      },
      "minItems": 0,
      "maxItems": 32
    },
    "overlap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "minItems": 1,
      "maxItems": 16
    },
    "anatomy_recognized": {
      "const": false
    },
    "review_status": {
      "const": "pending"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "source",
    "backend",
    "parameters",
    "elapsed_seconds",
    "candidates",
    "overlap",
    "overlay",
    "uncertainty",
    "anatomy_recognized",
    "review_status"
  ]
}
