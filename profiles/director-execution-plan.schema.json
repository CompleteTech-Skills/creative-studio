{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "kind": {
      "const": "execution-plan"
    },
    "state": {
      "const": "planned"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "test": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifact-ref"
            },
            "minItems": 0,
            "maxItems": 128
          }
        },
        "required": [
          "id",
          "test",
          "evidence"
        ]
      },
      "minItems": 1,
      "maxItems": 1024
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/graph-plan-node"
          },
          {
            "$ref": "#/$defs/graph-plan-node-v2"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 1024
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "artifact": {
            "$ref": "#/$defs/artifact-ref"
          }
        },
        "required": [
          "source",
          "target",
          "artifact"
        ]
      },
      "minItems": 0,
      "maxItems": 4096
    }
  },
  "required": [
    "schema_version",
    "kind",
    "state",
    "requirements",
    "nodes",
    "edges"
  ],
  "$defs": {
