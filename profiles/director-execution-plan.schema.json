            "$ref": "#/$defs/artifact-ref"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "output_schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "resource_class": {
          "enum": [
            "none",
            "cpu",
            "gpu",
            "io",
            "provider",
            "render"
          ]
        },
        "native_owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "estimated_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "execution_metadata": {
          "$ref": "#/$defs/execution-metadata"
        }
      },
      "required": [
        "id",
        "operation",
        "inputs",
        "output_schema",
        "resource_class",
        "native_owner",
        "required_capabilities",
        "estimated_seconds",
        "requirement_ids",
        "execution_metadata"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/graph-plan-node-v2"
            },
            "minItems": 1,
            "maxItems": 1024
          }
        }
      },
      "else": {
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/graph-plan-node"
            },
            "minItems": 1,
            "maxItems": 1024
          }
        }
      }
    }
  ]
}
