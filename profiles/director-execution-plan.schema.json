        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provenance_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact-ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixture": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact-ref"
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "schema_version",
        "semantic_version",
        "path",
        "sha256",
        "byte_size",
        "media_type",
        "provenance_ref",
        "fixture",
        "dependencies"
      ]
