{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hatch native liquid settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "hatch-3d-liquid-settings"
    },
    "emission_end_frame": {
      "type": "integer",
      "minimum": 1,
      "maximum": 63
    },
    "flow_behavior": {
      "enum": [
        "INFLOW",
        "GEOMETRY"
      ]
    },
    "initial_velocity": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -20,
        "maximum": 20
      }
    },
    "particle_radius": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2
    },
    "mesh_scale": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "collision_distance": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 10
    },
    "cfl": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 10
    },
    "minimum_substeps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "maximum_substeps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "front": {
          "type": "boolean"
        },
        "back": {
          "type": "boolean"
        },
        "left": {
          "type": "boolean"
        },
        "right": {
          "type": "boolean"
        },
        "top": {
          "type": "boolean"
        },
        "bottom": {
          "type": "boolean"
        }
      },
      "required": [
        "front",
        "back",
        "left",
        "right",
        "top",
        "bottom"
      ]
    },
    "render_frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 63
      }
    },
    "render_size": {
      "type": "integer",
      "minimum": 64,
      "maximum": 256
    },
    "render_samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    }
  },
  "required": [
    "schema_version",
    "kind",
    "emission_end_frame",
    "flow_behavior",
    "initial_velocity",
    "particle_radius",
    "mesh_scale",
    "collision_distance",
    "cfl",
    "minimum_substeps",
    "maximum_substeps",
    "boundaries",
    "render_frames",
    "render_size",
    "render_samples"
  ]
}
