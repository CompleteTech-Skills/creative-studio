{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RenderResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "render3d-result"
        },
        "job": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "adapter_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
            },
            "application_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "executable_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "worker_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "platform": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "engine": {
              "enum": [
                "cycles",
                "eevee"
              ]
            },
            "device": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "id",
            "adapter_version",
            "application_version",
            "executable_sha256",
            "worker_sha256",
            "platform",
            "engine",
            "device"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "cancelled"
          ]
        },
        "requested_frames": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "minItems": 1,
          "maxItems": 100000
        },
        "successful": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "minItems": 0,
          "maxItems": 100000
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "minItems": 0,
          "maxItems": 100000
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "minItems": 0,
          "maxItems": 100000
        },
        "reused": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "minItems": 0,
          "maxItems": 100000
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "file": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 268435456
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ]
              },
              "format": {
                "enum": [
                  "png",
                  "exr"
                ]
              },
              "bit_depth": {
                "enum": [
                  8,
                  16,
                  32
                ]
              },
              "pass_name": {
                "enum": [
                  "combined",
                  "depth",
                  "normal",
                  "albedo"
                ]
              },
              "resolution": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "frame",
              "file",
              "format",
              "bit_depth",
              "pass_name",
              "resolution"
            ]
          },
          "minItems": 0,
          "maxItems": 400000
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "category": {
                "enum": [
                  "invalid-input",
                  "missing-asset",
                  "stale-asset",
                  "unsupported-feature",
                  "unsupported-backend",
                  "unsupported-device",
                  "device-initialization",
                  "gpu-out-of-memory",
                  "system-memory",
                  "storage-exhaustion",
                  "timeout",
                  "worker-crash",
                  "cancelled",
                  "corrupt-output",
                  "incomplete-output",
                  "stale-cache",
                  "verification-failed",
                  "external-tool",
                  "ownership"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "path": {
                "type": "string",
                "maxLength": 1024
              },
              "remediation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "code",
              "category",
              "message",
              "path",
              "remediation"
            ]
          },
          "minItems": 0,
          "maxItems": 1024
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "elapsed_seconds": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000.0
                },
                {
                  "type": "null"
                }
              ]
            },
            "peak_memory_bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "measurement": {
              "enum": [
                "measured",
                "estimated",
                "unavailable"
              ]
            }
          },
          "required": [
            "elapsed_seconds",
            "peak_memory_bytes",
            "output_bytes",
            "measurement"
          ]
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 268435456
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ]
          },
          "minItems": 0,
          "maxItems": 1024
        },
        "manifest": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 268435456
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "not-run",
                "passed",
                "failed"
              ]
            },
            "verifier": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
                    },
                    "version": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
                    },
                    "code_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                    },
                    "platform": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    }
                  },
                  "required": [
                    "id",
                    "version",
                    "code_sha256",
                    "platform"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 268435456
                    }
                  },
                  "required": [
                    "path",
                    "sha256",
                    "bytes"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "verifier",
            "evidence"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "job",
        "request_sha256",
        "snapshot_sha256",
        "backend",
        "status",
        "requested_frames",
        "successful",
        "failed",
        "skipped",
        "reused",
        "images",
        "diagnostics",
        "usage",
        "logs",
        "manifest",
        "verification"
      ]
    }
  },
  "$ref": "#/$defs/RenderResult",
  "title": "Render3D RenderResult v1"
}
