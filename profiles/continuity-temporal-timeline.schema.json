            "shots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/temporal-shot"
              },
              "minItems": 1,
              "maxItems": 4096
            },
            "dependencies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ref"
              },
              "minItems": 0,
              "maxItems": 4096
            }
          },
          "required": [
            "schema_version",
            "kind",
            "timeline_id",
            "branch_id",
            "project_id",
            "project_revision",
            "world_id",
            "ticks_per_second",
            "scenes",
            "shots",
            "dependencies"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": "1.1.0"
            },
            "kind": {
              "const": "continuity-temporal-timeline"
            },
