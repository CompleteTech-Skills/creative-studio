          "$ref": "#/$defs/world-fact-scope"
        },
        "category": {
          "enum": [
            "knowledge",
            "objective",
            "relationship",
            "intention",
            "emotion",
            "discovery",
            "action",
            "consequence",
            "milestone",
            "condition",
            "other"
          ]
        },
        "certainty": {
          "enum": [
            "definitive",
            "inferred",
            "unknown",
            "unresolved"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "maxLength": 4096
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
