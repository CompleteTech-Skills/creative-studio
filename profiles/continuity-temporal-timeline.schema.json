            "timeline_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "branch_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "project_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "project_revision": {
              "$ref": "#/$defs/ref"
            },
            "world_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "ticks_per_second": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "scenes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/temporal-scene"
              },
              "minItems": 1,
              "maxItems": 4096
