      "required": [
        "id",
        "scope",
        "category",
        "certainty",
        "value",
        "causes",
        "evidence"
      ]
    },
    "world-fact-scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "project",
            "world",
            "scene",
            "character",
            "shot",
            "trait",
            "time-bounded"
