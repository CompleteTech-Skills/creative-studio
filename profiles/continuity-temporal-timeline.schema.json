            {
              "type": "null"
            }
          ]
        },
        "end_tick": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "subject",
        "start_tick",
        "end_tick"
      ]
    }
  },
  "$ref": "#/$defs/temporal-timeline"
}
