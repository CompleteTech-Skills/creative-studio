          "required": [
            "schema_version",
            "kind",
            "timeline_id",
            "branch_id",
            "project_id",
            "project_revision",
            "world_id",
            "ticks_per_second",
            "scenes",
            "shots",
            "dependencies",
            "world_state"
          ]
        }
      ]
