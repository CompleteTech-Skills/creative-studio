{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animation3D scene v1",
  "$ref": "#/$defs/scene",
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "kind"
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "enum": [
            "look_at",
            "aim",
            "parent",
            "position",
            "rotation",
            "scale",
            "distance",
            "limit",
            "two_bone_ik",
            "multi_bone_ik",
            "foot_plant",
            "grasp",
            "path_follow"
          ]
        },
        "source": {
          "$ref": "#/$defs/target"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "target_object_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "target_position": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000000.0,
            "maximum": 1000000000.0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "pole_target": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000000.0,
            "maximum": 1000000000.0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "chain_bones": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "position_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "maximum": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "minimum",
            "maximum"
          ]
        },
        "rotation_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum_rad": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "maximum_rad": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "minimum_rad",
            "maximum_rad"
          ]
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "weight",
        "enabled"
      ]
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "animation_interaction_3d"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "actor_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "role": {
                "enum": [
                  "giver",
                  "receiver",
                  "support",
                  "participant"
                ]
              },
              "hand_bone": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "grip_anchor": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "interaction_marker": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              }
            },
            "required": [
              "actor_id",
              "role"
            ]
          },
          "minItems": 1,
          "maxItems": 128
        },
        "prop_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "synchronization_markers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "ownership_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "previous_owner": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "next_owner": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "previous_anchor": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "next_anchor": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "world_pose_policy": {
                "enum": [
                  "preserve",
                  "blend_to_receiver",
                  "explicit"
                ]
              },
              "transfer_duration_frames": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              }
            },
            "required": [
              "frame",
              "world_pose_policy"
            ]
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "position_tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0
        },
        "orientation_tolerance_rad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0
        },
        "failure_policy": {
          "enum": [
            "error",
            "flag_for_review"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "participants",
        "start_frame",
        "end_frame",
        "synchronization_markers",
        "constraints",
        "position_tolerance_m",
        "orientation_tolerance_rad",
        "failure_policy"
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": {
          "$ref": "#/$defs/time"
        },
        "value": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "interpolation": {
          "enum": [
            "step",
            "linear",
            "ease",
            "bezier",
            "hermite",
            "catmull-rom",
            "tcb",
            "quaternion-slerp",
            "quaternion-squad"
          ]
        },
        "ease_in": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ease_out": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "in_tangent": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "out_tangent": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "in_handle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time_delta_frames": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "value_delta": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              ]
            },
            "weighted": {
              "type": "boolean"
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000.0
            }
          },
          "required": [
            "time_delta_frames",
            "value_delta"
          ]
        },
        "out_handle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time_delta_frames": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "value_delta": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              ]
            },
            "weighted": {
              "type": "boolean"
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000.0
            }
          },
          "required": [
            "time_delta_frames",
            "value_delta"
          ]
        },
        "tension": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        },
        "continuity": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        },
        "bias": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 4096
          },
          "maxProperties": 128
        }
      },
      "required": [
        "time",
        "value"
      ]
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "priority": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        },
        "blend_mode": {
          "enum": [
            "override",
            "additive",
            "multiply"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weight_track": {
          "$ref": "#/$defs/track"
        },
        "bone_mask": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "included_bones": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "minItems": 0,
              "maxItems": 4096
            },
            "excluded_bones": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "minItems": 0,
              "maxItems": 4096
            },
            "include_descendants": {
              "type": "boolean"
            },
            "per_bone_weights": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "maxProperties": 4096
            }
          },
          "required": []
        },
        "affected_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "reference_pose": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "muted": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean"
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placement"
          },
          "minItems": 0,
          "maxItems": 4096
        }
      },
      "required": [
        "id",
        "name",
        "priority",
        "blend_mode",
        "weight",
        "muted",
        "solo",
        "placements"
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "clip": {
          "$ref": "#/$defs/asset"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "source_in_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "source_out_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "playback_rate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "numerator",
            "denominator"
          ]
        },
        "reverse": {
          "type": "boolean"
        },
        "loop_override": {
          "enum": [
            "inherit",
            "once",
            "loop",
            "ping_pong"
          ]
        },
        "blend_in_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "blend_out_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weight_track": {
          "$ref": "#/$defs/track"
        },
        "layer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "time_offset_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "clip",
        "start_frame",
        "duration_frames",
        "source_in_frame",
        "playback_rate",
        "blend_in_frames",
        "blend_out_frames",
        "weight",
        "layer_id",
        "enabled"
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "animation_scene_3d"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "scene_asset": {
          "$ref": "#/$defs/asset"
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "actor_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "model": {
                "$ref": "#/$defs/asset"
              },
              "rig": {
                "$ref": "#/$defs/asset"
              },
              "initial_transform": {
                "$ref": "#/$defs/transform"
              },
              "animation_layers": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/layer"
                },
                "minItems": 0,
                "maxItems": 128
              },
              "state_machine": {
                "$ref": "#/$defs/asset"
              },
              "retarget_profile": {
                "$ref": "#/$defs/asset"
              },
              "constraints": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/constraint"
                },
                "minItems": 0,
                "maxItems": 128
              },
              "initial_state_parameters": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "boolean",
                    "number"
                  ]
                },
                "maxProperties": 128
              }
            },
            "required": [
              "actor_id",
              "model",
              "initial_transform",
              "animation_layers",
              "constraints"
            ]
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "object_tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "environment_tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "camera_tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "lighting_tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "interactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interaction"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "markers": {
          "type": "array",
