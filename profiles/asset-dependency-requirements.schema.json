                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 67108864
                    }
                  },
                  "required": [
                    "path",
                    "sha256",
                    "bytes"
                  ]
                },
                "maxItems": 256
              }
            },
            "required": [
              "library",
              "reference",
              "library_id",
              "files"
            ]
