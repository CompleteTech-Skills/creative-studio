              },
              "required": {
                "type": "boolean"
              },
              "cause": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "code",
              "asset",
              "required"
            ]
          },
          "maxItems": 65536
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "roots",
        "nodes",
        "edges",
        "diagnostics",
        "complete"
