                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])",
                        "maxLength": 64
                      },
                      "version": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])",
                        "maxLength": 32
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
                      }
                    },
                    "required": [
                      "id",
                      "version",
                      "sha256"
                    ]
                  }
                },
                "required": [
                  "library",
                  "reference"
