              ]
            }
          },
          "required": [
            "library",
            "reference"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "asset": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "library": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "reference": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])",
