        "unit_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "skeleton_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "rest_pose_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "skin_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "morph_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
